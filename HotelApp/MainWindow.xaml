<Window x:Class="HotelApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:HotelApp.ViewModels"
        Title="Hotel Management System" Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}">

    <!-- Контекст данных главного окна -->
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <!-- Ресурсы главного окна -->
    <Window.Resources>
        <!-- ШАБЛОН: ОКНО ДОБАВЛЕНИЯ КОРПУСА -->
        <DataTemplate x:Key="AddBuildingDialogTemplate">
            <materialDesign:Card Width="380" UniformCornerRadius="8">
                <StackPanel Margin="24">
                    <TextBlock Text="Новый корпус" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                    <TextBox x:Name="BuildingNameTextBox" Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             MaxLength="50" materialDesign:HintAssist.Hint="Название (например, Корпус В)" Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Отмена" Style="{StaticResource MaterialDesignFlatButton}" 
                                Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Margin="0,0,10,0"/>
                        <Button Content="Создать" Style="{StaticResource MaterialDesignRaisedButton}" 
                                Click="ConfirmAddBuilding_Click"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </DataTemplate>

        <DataTemplate x:Key="EditPriceDialogTemplate">
            <materialDesign:Card Width="350" UniformCornerRadius="8">
                <StackPanel Margin="24">
                    <TextBlock Text="Изменение цены" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                    <TextBox x:Name="NewPriceTextBox" Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             MaxLength="9" PreviewTextInput="Digits_PreviewTextInput" DataObject.Pasting="Digits_Pasting"
                             materialDesign:HintAssist.Hint="Новая цена (₽)" Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Отмена" Style="{StaticResource MaterialDesignFlatButton}" 
                                Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Margin="0,0,10,0"/>
                        <Button Content="Сохранить" Style="{StaticResource MaterialDesignRaisedButton}" 
                                Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" CommandParameter="True"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </DataTemplate>

        <!-- ШАБЛОН: ОКНО ДОБАВЛЕНИЯ НОМЕРА -->
        <DataTemplate x:Key="AddRoomDialogTemplate">
            <materialDesign:Card Width="400" UniformCornerRadius="8">
                <materialDesign:Card.Content>
                    <StackPanel Margin="24">
                        <TextBlock Text="Новый номер" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                        <TextBlock Text="Корпус:" Margin="0,0,0,5" Foreground="Gray"/>
                        <ComboBox x:Name="BuildingComboBox" Margin="0,0,0,15" DisplayMemberPath="Name" SelectedValuePath="Id"
                                  ItemsSource="{Binding Source={x:Static Application.Current}, Path=MainWindow.DataContext.Buildings}"/>
                        <TextBlock Text="Тип номера:" Margin="0,0,0,5" Foreground="Gray"/>
                        <ComboBox x:Name="RoomTypeComboBox" Margin="0,0,0,15" SelectedIndex="0">
                            <ComboBoxItem Content="Стандарт"/>
                            <ComboBoxItem Content="Люкс"/>
                            <ComboBoxItem Content="Конференц-зал"/>
                        </ComboBox>
                        <TextBox x:Name="RoomNumberTextBox" Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                                 MaxLength="5" PreviewTextInput="Digits_PreviewTextInput" DataObject.Pasting="Digits_Pasting"
                                 materialDesign:HintAssist.Hint="Номер (только цифры, например, 105)" Margin="0,0,0,15"/>
                        <TextBox x:Name="RoomPriceTextBox" Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                                 MaxLength="9" PreviewTextInput="Digits_PreviewTextInput" DataObject.Pasting="Digits_Pasting"
                                 materialDesign:HintAssist.Hint="Цена за сутки (₽, целое число)" Text="2000" Margin="0,0,0,20"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Отмена" Style="{StaticResource MaterialDesignFlatButton}" 
                                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Margin="0,0,10,0"/>
                            <Button Content="Создать" Style="{StaticResource MaterialDesignRaisedButton}" Click="ConfirmAddRoom_Click"/>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card.Content>
            </materialDesign:Card>
        </DataTemplate>

        <!-- ШАБЛОН: ОКНО ЗАСЕЛЕНИЯ -->
        <DataTemplate x:Key="CheckInDialogTemplate">
            <materialDesign:Card Width="380" UniformCornerRadius="8">
                <materialDesign:Card.Content>
                    <StackPanel Margin="24">
                        <TextBlock Text="Заселение гостя" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                        <TextBox x:Name="GuestNameTextBox" Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                                 MaxLength="100" PreviewTextInput="Name_PreviewTextInput" DataObject.Pasting="Name_Pasting"
                                 materialDesign:HintAssist.Hint="ФИО Гостя (только буквы)" Margin="0,0,0,15"/>
                        <TextBox x:Name="GuestPassportTextBox" Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                                 MaxLength="11" PreviewTextInput="Passport_PreviewTextInput" DataObject.Pasting="Passport_Pasting"
                                 TextChanged="Passport_TextChanged" materialDesign:HintAssist.Hint="Паспорт: 1234 567890" Margin="0,0,0,15"/>
                        <TextBlock Text="Дата заезда:" Margin="0,0,0,5"/>
                        <DatePicker x:Name="CheckInDatePicker" Margin="0,0,0,15" PreviewTextInput="Date_PreviewTextInput" PreviewKeyDown="Date_PreviewKeyDown" DataObject.Pasting="Date_Pasting"/>
                        <TextBlock Text="Дата выезда:" Margin="0,0,0,5"/>
                        <DatePicker x:Name="CheckOutDatePicker" Margin="0,0,0,20" PreviewTextInput="Date_PreviewTextInput" PreviewKeyDown="Date_PreviewKeyDown" DataObject.Pasting="Date_Pasting"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Отмена" Style="{StaticResource MaterialDesignFlatButton}" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Margin="0,0,10,0"/>
                            <Button Content="Заселить" Style="{StaticResource MaterialDesignRaisedButton}" Click="ConfirmCheckIn_Click"/>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card.Content>
            </materialDesign:Card>
        </DataTemplate>

        <!-- ШАБЛОН: ОКНО БРОНИРОВАНИЯ -->
        <DataTemplate x:Key="BookingDialogTemplate">
            <materialDesign:Card Width="380" UniformCornerRadius="8">
                <materialDesign:Card.Content>
                    <StackPanel Margin="24">
                        <TextBlock Text="Бронирование номера" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                        <TextBox x:Name="BookingGuestNameTextBox" Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                                 MaxLength="100" PreviewTextInput="Name_PreviewTextInput" DataObject.Pasting="Name_Pasting"
                                 materialDesign:HintAssist.Hint="ФИО Гостя (только буквы)" Margin="0,0,0,15"/>
                        <TextBox x:Name="BookingGuestPassportTextBox" Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                                 MaxLength="11" PreviewTextInput="Passport_PreviewTextInput" DataObject.Pasting="Passport_Pasting"
                                 TextChanged="Passport_TextChanged" materialDesign:HintAssist.Hint="Паспорт: 1234 567890" Margin="0,0,0,15"/>
                        <TextBlock Text="Дата заезда:" Margin="0,0,0,5"/>
                        <DatePicker x:Name="BookingCheckInDatePicker" Margin="0,0,0,15" PreviewTextInput="Date_PreviewTextInput" PreviewKeyDown="Date_PreviewKeyDown" DataObject.Pasting="Date_Pasting"/>
                        <TextBlock Text="Дата выезда:" Margin="0,0,0,5"/>
                        <DatePicker x:Name="BookingCheckOutDatePicker" Margin="0,0,0,20" PreviewTextInput="Date_PreviewTextInput" PreviewKeyDown="Date_PreviewKeyDown" DataObject.Pasting="Date_Pasting"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Отмена" Style="{StaticResource MaterialDesignFlatButton}" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Margin="0,0,10,0"/>
                            <Button Content="Забронировать" Style="{StaticResource MaterialDesignRaisedButton}" Click="ConfirmBooking_Click"/>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card.Content>
            </materialDesign:Card>
        </DataTemplate>

        <!-- ШАБЛОН: ОКНО ИМПОРТА ИЗ EXCEL -->
        <DataTemplate x:Key="ImportDialogTemplate">
            <Border Width="1000" Height="600" CornerRadius="8" Background="{DynamicResource MaterialDesignPaper}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Импорт гостей из Excel" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="1" Text="{Binding SummaryText}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="2" FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Обязательные колонки: ФИО, Паспорт, Корпус, Тип номера, Номер, Цена за сутки, Дата заезда, Дата выезда."/>

                    <DataGrid Grid.Row="3" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single" RowHeight="32">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Background" Value="#FFFCE4E4"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Стр." Binding="{Binding LineNumber}" Width="62" MinWidth="55"/>
                            <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="180" MinWidth="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="ToolTip" Value="{Binding FullName}"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Корпус" Binding="{Binding Building}" Width="130" MinWidth="110"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding RoomType}" Width="135" MinWidth="110"/>
                            <DataGridTextColumn Header="Номер" Binding="{Binding RoomNumber}" Width="75" MinWidth="65"/>
                            <DataGridTextColumn Header="Цена" Binding="{Binding PriceText}" Width="85" MinWidth="85"/>
                            <DataGridTextColumn Header="Даты" Binding="{Binding DatesDisplay}" Width="185" MinWidth="165"/>
                            <DataGridTemplateColumn Header="Статус" Width="*" MinWidth="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,2" ToolTip="{Binding Status}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                            <Setter Property="Foreground" Value="#C62828"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasError}" Value="False">
                                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Отмена" Style="{StaticResource MaterialDesignFlatButton}" Click="CancelImport_Click" Margin="0,0,10,0"/>
                        <Button Content="Импортировать" Style="{StaticResource MaterialDesignRaisedButton}" Click="ConfirmImport_Click" IsEnabled="{Binding HasValidRows}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- НОВЫЙ ШАБЛОН: ОКНО "О ПРОГРАММЕ" -->
        <DataTemplate x:Key="AboutDialogTemplate">
            <materialDesign:Card Width="500" UniformCornerRadius="8">
                <StackPanel>
                    <Border Background="{DynamicResource PrimaryHueMidBrush}" CornerRadius="8,8,0,0" Padding="24,20">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Hotel" Width="32" Height="32" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="О программе" Foreground="White" FontSize="22" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="24">
                        <TextBlock Text="Hotel Management System" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,10"/>
                        <TextBlock TextWrapping="Wrap" LineHeight="20" FontSize="13" Margin="0,0,0,15">
                            <Run Text="Это современное решение для управления гостиничным бизнесом, созданное для того, чтобы сделать работу администратора быстрой, удобной и понятной."/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" LineHeight="20" FontSize="13" Margin="0,0,0,15">
                            <Run Text="В основе программы лежит мощное ядро на C++, которое мгновенно обрабатывает данные, а современный интерфейс позволяет управлять всем в пару кликов."/>
                        </TextBlock>
                        <TextBlock Text="Главные фишки:" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5"/>
                        <TextBlock Text="• Умный импорт гостей и броней прямо из Excel." FontSize="13" Margin="10,0,0,5"/>
                        <TextBlock Text="• Наглядная карта отеля с цветовой индикацией." FontSize="13" Margin="10,0,0,5"/>
                        <TextBlock Text="• Честная аналитика: графики выручки и популярности номеров." FontSize="13" Margin="10,0,0,5"/>
                        <TextBlock Text="• Надежное хранение данных в файл." FontSize="13" Margin="10,0,0,15"/>
                        <TextBlock TextWrapping="Wrap" LineHeight="20" FontSize="13" FontStyle="Italic" Margin="0,0,0,20">
                            <Run Text="Программа написана с любовью к чистоте кода и удобству пользователей. Надеюсь, вам понравится ей пользоваться так же, как мне было интересно её создавать!"/>
                        </TextBlock>
                        <Separator Margin="0,0,0,15"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Разработчик: " FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock FontSize="13" VerticalAlignment="Center">
                                <Hyperlink NavigateUri="https://github.com/OneWayToDie" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{DynamicResource PrimaryHueMidBrush}">
                                    OneWayToDie
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="0,0,8,8" Padding="24,16">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Закрыть" Style="{StaticResource MaterialDesignRaisedButton}" 
                                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" IsDefault="True" Width="120"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </materialDesign:Card>
        </DataTemplate>

        <!-- Диалог: Гости по типу номера (Drill-down) -->
        <DataTemplate x:Key="RoomTypeDetailsDialogTemplate">
            <materialDesign:Card Width="700" MaxHeight="600" Padding="24" UniformCornerRadius="12">
                <Grid>
                    <!-- Три строки: заголовок, таблица (растягивается), кнопка (всегда видна) -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 1. ЗАГОЛОВОК -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Гости по выбранному типу номера" 
                           FontSize="20" FontWeight="Bold" 
                           Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <TextBlock Text="{Binding SelectedTypeGuests.Count, StringFormat='Найдено записей: {0}'}" 
                           FontSize="13" Foreground="Gray" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- 2. ТАБЛИЦА (занимает всё доступное пространство, скроллится внутри) -->
                    <DataGrid Grid.Row="1"
                      ItemsSource="{Binding SelectedTypeGuests}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      FontSize="13"
                      RowHeight="36"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ФИО гостя" 
                                        Binding="{Binding GuestName}" 
                                        Width="*" MinWidth="180"/>
                            <DataGridTextColumn Header="Паспорт" 
                                        Binding="{Binding Passport}" 
                                        Width="130"/>
                            <DataGridTextColumn Header="Номер" 
                                        Binding="{Binding RoomNumber}" 
                                        Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Даты проживания" 
                                        Binding="{Binding DatesDisplay}" 
                                        Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 3. КНОПКА (всегда видна внизу, не уходит за экран) -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Закрыть" 
                        Width="120"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </DataTemplate>



    </Window.Resources>

    <!-- Корневой контейнер диалогов -->
    <materialDesign:DialogHost Identifier="RootDialog">
        <!-- Основная сетка главного окна -->
        <Grid>
            <!-- Колонки основной разметки -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ЛЕВОЕ МЕНЮ (SIDEBAR) -->
            <Border Grid.Column="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0F172A" Offset="0.0"/>
                        <GradientStop Color="#1E293B" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>

                <DockPanel>
                    <!-- ВЕРХНЯЯ ЧАСТЬ: Логотип и Меню -->
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" Margin="20,30,20,20">
                            <materialDesign:PackIcon Kind="Hotel" Width="36" Height="36" Foreground="White" VerticalAlignment="Center"/>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="HOTEL PRO" Foreground="White" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="Management System" Foreground="#94A3B8" FontSize="10"/>
                            </StackPanel>
                        </StackPanel>

                        <ListBox x:Name="MenuList" SelectedIndex="0" Background="Transparent" BorderThickness="0" Foreground="White" SelectionChanged="MenuList_SelectionChanged" Margin="0,10,0,0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="20,12"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#44FFFFFF"/>
                                                        <Setter TargetName="Bd" Property="BorderThickness" Value="4,0,0,0"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="OfficeBuilding" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Номера и Фонд" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountGroup" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="База гостей" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ChartBox" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Аналитика" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="MapMarkerRadius" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Карта отеля" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                            <!-- Настройки -->
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CogOutline" 
                                                             Width="22" Height="22" 
                                                             Margin="0,0,10,0"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Настройки" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>

                        <!-- ВИДЖЕТ ЗАГРУЗКИ -->
                        <Border Margin="20,20,20,0" Padding="12" Background="#11FFFFFF" CornerRadius="8">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Загрузка отеля" Foreground="#94A3B8" FontSize="12"/>
                                    <TextBlock Text="{Binding OccupancyPercent, StringFormat={}{0:F0}%}" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar Value="{Binding OccupancyPercent, Mode=OneWay}" Height="6" Margin="0,8,0,0" 
                                             Foreground="{DynamicResource PrimaryHueMidBrush}" Background="#33FFFFFF" BorderThickness="0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- НИЖНЯЯ ЧАСТЬ: Админ и О программе -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,20">
                        <Border Padding="10" Background="#11FFFFFF" CornerRadius="8" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountCircle" Width="40" Height="40" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Администратор" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="Система онлайн" Foreground="MediumSeaGreen" FontSize="10"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Button Click="OpenAbout_Click" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="InformationOutline" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="О программе" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Правая часть главного окна -->
            <Grid Grid.Column="1">
                <!-- Строки разметки правой части -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="150"/>
                </Grid.RowDefinitions>

                <!-- ШАПКА -->
                <Border Grid.Row="0" Background="White" Padding="20" Effect="{DynamicResource MaterialDesignShadowDepth1}">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,30,0">
                                <TextBlock Text="Всего номеров" Foreground="Gray" FontSize="12"/>
                                <TextBlock Text="{Binding TotalRooms}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,30,0">
                                <TextBlock Text="Свободно" Foreground="Gray" FontSize="12"/>
                                <TextBlock Text="{Binding FreeRooms}" FontSize="20" FontWeight="Bold" Foreground="Green"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,30,0">
                                <TextBlock Text="Занято" Foreground="Gray" FontSize="12"/>
                                <TextBlock Text="{Binding OccupiedRooms}" FontSize="20" FontWeight="Bold" Foreground="Red"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Индикатор состояния базы данных: зелёный — успех, красный — ошибка -->
                            <Border Margin="0,0,10,0" Padding="10,6" CornerRadius="12" Background="#F5F5F5"
                                    VerticalAlignment="Center" ToolTip="{Binding DatabaseStatusToolTip}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="DatabaseStatusDot" Width="10" Height="10" Fill="{Binding DatabaseStatusBrush}"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding DatabaseStatusText}" FontSize="11"
                                               Foreground="Gray" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Сохранить таблицу -->
                            <Button Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,5,0" Click="ExportTemplate_Click" ToolTip="Сохранить таблицу Excel (по умолчанию — в папку программы)">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileDocumentOutline" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Сохранить таблицу" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Импорт -->
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,5,0" Click="ImportExcel_Click" ToolTip="Загрузить данные из Excel (по умолчанию — из папки программы)">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileExcelOutline" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Импорт Excel" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- + Корпус -->
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,5,0" Click="OpenAddBuilding_Click" ToolTip="Добавить новый корпус">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Корпус" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- + Номер -->
                            <Button Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,5,0" Click="OpenAddRoom_Click" ToolTip="Добавить новый номер">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="DoorOpen" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="+ Номер" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Очистить БД -->
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="IndianRed" BorderBrush="IndianRed" Click="ClearDatabase_Click" ToolTip="Полная очистка всех данных">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Очистить БД" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ОБЛАСТЬ КОНТЕНТА: плавное появление вкладок -->
                <materialDesign:TransitioningContent x:Name="MainContent" Grid.Row="1"
                                                     Content="{Binding CurrentView}">
                    <materialDesign:TransitioningContent.OpeningEffect>
                        <materialDesign:TransitionEffect Kind="FadeIn" Duration="0:0:0.28"/>
                    </materialDesign:TransitioningContent.OpeningEffect>
                </materialDesign:TransitioningContent>

                <!-- ЖУРНАЛ -->
                <Border Grid.Row="2" Background="#1E1E1E" Padding="15">
                    <ListBox Background="Transparent" BorderThickness="0" ItemsSource="{Binding EventLog}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Time}" Foreground="Gray" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Message}" Foreground="{Binding Color}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- ВСПЛЫВАЮЩИЕ УВЕДОМЛЕНИЯ (TOAST) -->
            <StackPanel x:Name="ToastHost" Grid.ColumnSpan="2" Panel.ZIndex="150"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,24,24" IsHitTestVisible="False"/>

            <!-- ОВЕРЛЕЙ ИМПОРТА EXCEL (Восстановлен!) -->
            <Grid x:Name="ImportOverlay" Grid.ColumnSpan="2" Panel.ZIndex="100" Visibility="Collapsed" KeyDown="ImportOverlay_KeyDown">
                <Border Background="#8C000000" MouseLeftButtonDown="ImportOverlay_Click"/>
                <ContentControl x:Name="ImportDialogHost" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False"/>
            </Grid>
        </Grid>
    </materialDesign:DialogHost>
</Window>