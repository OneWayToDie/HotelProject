<Window x:Class="HotelApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:HotelApp.ViewModels"
        Title="Hotel Management System" Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- ШАБЛОН: ОКНО ДОБАВЛЕНИЯ КОРПУСА -->
        <DataTemplate x:Key="AddBuildingDialogTemplate">
            <materialDesign:Card Width="380" UniformCornerRadius="8">
                <StackPanel Margin="24">
                    <TextBlock Text="Новый корпус" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                    <TextBox x:Name="BuildingNameTextBox" Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             MaxLength="50"
                             materialDesign:HintAssist.Hint="Название (например, Корпус В)" Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Отмена" Style="{StaticResource MaterialDesignFlatButton}" 
                                Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Margin="0,0,10,0"/>
                        <Button Content="Создать" Style="{StaticResource MaterialDesignRaisedButton}" 
                                Click="ConfirmAddBuilding_Click"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </DataTemplate>

        <DataTemplate x:Key="EditPriceDialogTemplate">
            <materialDesign:Card Width="350" UniformCornerRadius="8">
                <StackPanel Margin="24">
                    <TextBlock Text="Изменение цены" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                    <TextBox x:Name="NewPriceTextBox" Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             MaxLength="9"
                             PreviewTextInput="Digits_PreviewTextInput"
                             DataObject.Pasting="Digits_Pasting"
                             materialDesign:HintAssist.Hint="Новая цена (₽)" Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Отмена" Style="{StaticResource MaterialDesignFlatButton}" 
                                Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Margin="0,0,10,0"/>
                        <Button Content="Сохранить" Style="{StaticResource MaterialDesignRaisedButton}" 
                                Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" 
                                CommandParameter="True"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </DataTemplate>


        <!-- ШАБЛОН: ОКНО ДОБАВЛЕНИЯ НОМЕРА -->
        <DataTemplate x:Key="AddRoomDialogTemplate">
            <materialDesign:Card Width="400" UniformCornerRadius="8">
                <materialDesign:Card.Content>
                    <StackPanel Margin="24">
                        <TextBlock Text="Новый номер" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                        <TextBlock Text="Корпус:" Margin="0,0,0,5" Foreground="Gray"/>
                        <ComboBox x:Name="BuildingComboBox" Margin="0,0,0,15" 
                                  DisplayMemberPath="Name" SelectedValuePath="Id"
                                  ItemsSource="{Binding Source={x:Static Application.Current}, Path=MainWindow.DataContext.Buildings}"/>

                        <TextBlock Text="Тип номера:" Margin="0,0,0,5" Foreground="Gray"/>
                        <ComboBox x:Name="RoomTypeComboBox" Margin="0,0,0,15" SelectedIndex="0">
                            <ComboBoxItem Content="Стандарт"/>
                            <ComboBoxItem Content="Люкс"/>
                            <ComboBoxItem Content="Конференц-зал"/>
                        </ComboBox>

                        <TextBox x:Name="RoomNumberTextBox" Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                                 MaxLength="5"
                                 PreviewTextInput="Digits_PreviewTextInput"
                                 DataObject.Pasting="Digits_Pasting"
                                 materialDesign:HintAssist.Hint="Номер (только цифры, например, 105)" Margin="0,0,0,15"/>

                        <TextBox x:Name="RoomPriceTextBox" Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                                 MaxLength="9"
                                 PreviewTextInput="Digits_PreviewTextInput"
                                 DataObject.Pasting="Digits_Pasting"
                                 materialDesign:HintAssist.Hint="Цена за сутки (₽, целое число)" Text="2000" Margin="0,0,0,20"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Отмена" Style="{StaticResource MaterialDesignFlatButton}" 
                                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Margin="0,0,10,0"/>
                            <!-- Мы возвращаем текст из TextBox в качестве результата -->
                            <Button Content="Создать" Style="{StaticResource MaterialDesignRaisedButton}" 
                                Click="ConfirmAddRoom_Click"/>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card.Content>
            </materialDesign:Card>
        </DataTemplate>

        <!-- ШАБЛОН: ОКНО ЗАСЕЛЕНИЯ -->
        <DataTemplate x:Key="CheckInDialogTemplate">
            <materialDesign:Card Width="380" UniformCornerRadius="8">
                <materialDesign:Card.Content>
                    <StackPanel Margin="24">
                        <TextBlock Text="Заселение гостя" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                        <TextBox x:Name="GuestNameTextBox" Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                                 MaxLength="100"
                                 PreviewTextInput="Name_PreviewTextInput"
                                 DataObject.Pasting="Name_Pasting"
                                 materialDesign:HintAssist.Hint="ФИО Гостя (только буквы)" Margin="0,0,0,15"/>

                        <TextBox x:Name="GuestPassportTextBox" Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                                 MaxLength="11"
                                 PreviewTextInput="Passport_PreviewTextInput"
                                 DataObject.Pasting="Passport_Pasting"
                                 TextChanged="Passport_TextChanged"
                                 materialDesign:HintAssist.Hint="Паспорт: 1234 567890" Margin="0,0,0,15"/>

                        <!-- НОВЫЕ ДАТЫ -->
                        <TextBlock Text="Дата заезда:" Margin="0,0,0,5"/>
                        <DatePicker x:Name="CheckInDatePicker" Margin="0,0,0,15"
                                    PreviewTextInput="Date_PreviewTextInput"
                                    PreviewKeyDown="Date_PreviewKeyDown"
                                    DataObject.Pasting="Date_Pasting"/>

                        <TextBlock Text="Дата выезда:" Margin="0,0,0,5"/>
                        <DatePicker x:Name="CheckOutDatePicker" Margin="0,0,0,20"
                                    PreviewTextInput="Date_PreviewTextInput"
                                    PreviewKeyDown="Date_PreviewKeyDown"
                                    DataObject.Pasting="Date_Pasting"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Отмена" Style="{StaticResource MaterialDesignFlatButton}" 
                                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Margin="0,0,10,0"/>
                            <Button Content="Заселить" Style="{StaticResource MaterialDesignRaisedButton}" 
                                    Click="ConfirmCheckIn_Click"/>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card.Content>
            </materialDesign:Card>
        </DataTemplate>

        <!-- ШАБЛОН: ОКНО БРОНИРОВАНИЯ -->
        <DataTemplate x:Key="BookingDialogTemplate">
            <materialDesign:Card Width="380" UniformCornerRadius="8">
                <materialDesign:Card.Content>
                    <StackPanel Margin="24">
                        <TextBlock Text="Бронирование номера" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                        <TextBox x:Name="BookingGuestNameTextBox" Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                                 MaxLength="100"
                                 PreviewTextInput="Name_PreviewTextInput"
                                 DataObject.Pasting="Name_Pasting"
                                 materialDesign:HintAssist.Hint="ФИО Гостя (только буквы)" Margin="0,0,0,15"/>

                        <TextBox x:Name="BookingGuestPassportTextBox" Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                                 MaxLength="11"
                                 PreviewTextInput="Passport_PreviewTextInput"
                                 DataObject.Pasting="Passport_Pasting"
                                 TextChanged="Passport_TextChanged"
                                 materialDesign:HintAssist.Hint="Паспорт: 1234 567890" Margin="0,0,0,15"/>

                        <TextBlock Text="Дата заезда:" Margin="0,0,0,5"/>
                        <DatePicker x:Name="BookingCheckInDatePicker" Margin="0,0,0,15"
                                    PreviewTextInput="Date_PreviewTextInput"
                                    PreviewKeyDown="Date_PreviewKeyDown"
                                    DataObject.Pasting="Date_Pasting"/>

                        <TextBlock Text="Дата выезда:" Margin="0,0,0,5"/>
                        <DatePicker x:Name="BookingCheckOutDatePicker" Margin="0,0,0,20"
                                    PreviewTextInput="Date_PreviewTextInput"
                                    PreviewKeyDown="Date_PreviewKeyDown"
                                    DataObject.Pasting="Date_Pasting"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Отмена" Style="{StaticResource MaterialDesignFlatButton}" 
                                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Margin="0,0,10,0"/>
                            <Button Content="Забронировать" Style="{StaticResource MaterialDesignRaisedButton}" 
                                    Click="ConfirmBooking_Click"/>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card.Content>
            </materialDesign:Card>
        </DataTemplate>

        <!-- ШАБЛОН: ОКНО ИМПОРТА ИЗ EXCEL -->
        <!-- Намеренно Border, а не Card: Card навешивает DropShadowEffect + BitmapCache,
             из-за чего прокрутка таблицы перерисовывает всю карточку каждый кадр. -->
        <DataTemplate x:Key="ImportDialogTemplate">
            <Border Width="1000" Height="600" CornerRadius="8"
                    Background="{DynamicResource MaterialDesignPaper}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="1">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Импорт гостей из Excel" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" Text="{Binding SummaryText}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="2" FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Обязательные колонки: ФИО, Паспорт, Корпус, Тип номера, Номер, Цена за сутки, Дата заезда, Дата выезда. Каждая корректная строка создаёт бронь; отсутствующие корпуса и номера создаются автоматически. Строки с ошибками не импортируются."/>

                    <DataGrid Grid.Row="3" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                              SelectionMode="Single" RowHeight="32">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Background" Value="#FFFCE4E4"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Стр." Binding="{Binding LineNumber}" Width="62" MinWidth="55"/>
                            <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="180" MinWidth="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="ToolTip" Value="{Binding FullName}"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Корпус" Binding="{Binding Building}" Width="130" MinWidth="110"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding RoomType}" Width="135" MinWidth="110"/>
                            <DataGridTextColumn Header="Номер" Binding="{Binding RoomNumber}" Width="75" MinWidth="65"/>
                            <DataGridTextColumn Header="Цена" Binding="{Binding PriceText}" Width="85" MinWidth="85"/>
                            <DataGridTextColumn Header="Даты" Binding="{Binding DatesDisplay}" Width="185" MinWidth="165"/>
                            <DataGridTemplateColumn Header="Статус" Width="*" MinWidth="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- Без Wrap: фиксированная высота строки + всплывающая подсказка -->
                                        <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" Margin="4,2"
                                                   ToolTip="{Binding Status}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                            <Setter Property="Foreground" Value="#C62828"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasError}" Value="False">
                                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Отмена" Style="{StaticResource MaterialDesignFlatButton}"
                                Click="CancelImport_Click" Margin="0,0,10,0"/>
                        <Button Content="Импортировать" Style="{StaticResource MaterialDesignRaisedButton}"
                                Click="ConfirmImport_Click" IsEnabled="{Binding HasValidRows}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <materialDesign:DialogHost Identifier="RootDialog">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ЛЕВОЕ МЕНЮ -->
            <Border Grid.Column="0" Background="{DynamicResource PrimaryHueDarkBrush}">
                <StackPanel>
                    <TextBlock Text="HOTEL PRO" Foreground="White" FontSize="24" FontWeight="Bold" Margin="20,30,20,40"/>
                    <ListBox x:Name="MenuList" SelectedIndex="0" Background="Transparent" BorderThickness="0" Foreground="White" SelectionChanged="MenuList_SelectionChanged">
                        <ListBoxItem Content="🏢 Номера и Фонд" Padding="20,12"/>
                        <ListBoxItem Content="👥 База гостей" Padding="20,12"/>
                        <ListBoxItem Content="📊 Аналитика" Padding="20,12"/>
                        <ListBoxItem Content="🗺️ Карта отеля" Padding="20,12"/>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- ПРАВАЯ ЧАСТЬ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="150"/>
                </Grid.RowDefinitions>

                <!-- ШАПКА -->
                <Border Grid.Row="0" Background="White" Padding="20" Effect="{DynamicResource MaterialDesignShadowDepth1}">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,30,0">
                                <TextBlock Text="Всего номеров" Foreground="Gray" FontSize="12"/>
                                <TextBlock Text="{Binding TotalRooms}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,30,0">
                                <TextBlock Text="Свободно" Foreground="Gray" FontSize="12"/>
                                <TextBlock Text="{Binding FreeRooms}" FontSize="20" FontWeight="Bold" Foreground="Green"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,30,0">
                                <TextBlock Text="Занято" Foreground="Gray" FontSize="12"/>
                                <TextBlock Text="{Binding OccupiedRooms}" FontSize="20" FontWeight="Bold" Foreground="Red"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Шаблон" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,10,0" Click="ExportTemplate_Click"/>
                            <Button Content="Импорт Excel" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,10,0" Click="ImportExcel_Click"/>
                            <Button Content="+ Корпус" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,10,0" Click="OpenAddBuilding_Click"/>
                            <Button Content="+ Номер" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,10,0" Click="OpenAddRoom_Click"/>
                            <Button Content="Очистить БД" Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Foreground="IndianRed" BorderBrush="IndianRed"
                                    ToolTip="Полностью удалить все данные и начать с чистой базы"
                                    Click="ClearDatabase_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ОБЛАСТЬ КОНТЕНТА -->
                <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>

                <!-- ЖУРНАЛ -->
                <Border Grid.Row="2" Background="#1E1E1E" Padding="15">
                    <ListBox Background="Transparent" BorderThickness="0"
                             ItemsSource="{Binding EventLog}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Time}" Foreground="Gray" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Message}" Foreground="{Binding Color}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- ОВЕРЛЕЙ ИМПОРТА EXCEL -->
            <!-- Специально не DialogHost: его Popup — слоёное окно, и прокрутка
                 большой таблицы в нём падает до ~6 fps. Обычный слой в окне — быстрый. -->
            <Grid x:Name="ImportOverlay" Grid.ColumnSpan="2" Panel.ZIndex="100" Visibility="Collapsed"
                  KeyDown="ImportOverlay_KeyDown">
                <Border Background="#8C000000" MouseLeftButtonDown="ImportOverlay_Click"/>
                <ContentControl x:Name="ImportDialogHost"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Focusable="False"/>
            </Grid>
        </Grid>
    </materialDesign:DialogHost>
</Window>