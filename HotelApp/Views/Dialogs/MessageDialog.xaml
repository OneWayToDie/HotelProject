<!-- Окно диалогового сообщения -->
<Window x:Class="HotelApp.Views.Dialogs.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Сообщение"
        Width="440"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- Карточка содержимого диалога -->
    <materialDesign:Card Margin="16" UniformCornerRadius="8"
                         Background="{DynamicResource MaterialDesignPaper}"
                         materialDesign:ShadowAssist.ShadowDepth="Depth4">
        <!-- Основная сетка диалога -->
        <Grid Margin="24">
            <!-- Строки разметки диалога -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок с иконкой -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <materialDesign:PackIcon x:Name="DialogIcon" Width="32" Height="32"
                                         VerticalAlignment="Center" Margin="0,0,14,0"/>
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Текст сообщения -->
            <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,16,0,0"
                       FontSize="14" LineHeight="20" TextWrapping="Wrap"/>

            <!-- Флажок подтверждения опасного действия -->
            <CheckBox x:Name="ConfirmCheckBox" Grid.Row="2" Margin="0,18,0,0"
                      Content="Я понимаю последствия"
                      Visibility="Collapsed"
                      Checked="ConfirmCheckBox_Changed"
                      Unchecked="ConfirmCheckBox_Changed"/>

            <!-- Кнопки действий диалога -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,24,0,0">
                <Button x:Name="SecondaryButton" Style="{StaticResource MaterialDesignFlatButton}"
                        MinWidth="100" Margin="0,0,10,0" Click="Secondary_Click" IsCancel="True"/>
                <Button x:Name="PrimaryButton" Style="{StaticResource MaterialDesignRaisedButton}"
                        MinWidth="110" Click="Primary_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </materialDesign:Card>
</Window>
