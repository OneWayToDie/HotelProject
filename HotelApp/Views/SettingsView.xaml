<UserControl x:Class="HotelApp.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <materialDesign:Card Width="600" Padding="24" UniformCornerRadius="12">
        <StackPanel>
            <!-- Заголовок -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <materialDesign:PackIcon Kind="CogOutline" Width="28" Height="28"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                <TextBlock Text="Настройки" FontSize="22" FontWeight="Bold"
                           Margin="12,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            </StackPanel>

            <!-- Подзаголовок -->
            <TextBlock Text="Горячие клавиши" FontSize="16" FontWeight="SemiBold"
                       Margin="0,0,0,8"/>
            <TextBlock Text="Нажмите «Записать» у нужного действия, затем нажмите комбинацию клавиш."
                       FontSize="12" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <!-- Список горячих клавиш -->
            <ItemsControl ItemsSource="{Binding Hotkeys}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#F5F7FA" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <!-- Название действия -->
                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                           FontSize="14" VerticalAlignment="Center"/>

                                <!-- Текущая комбинация -->
                                <TextBox Grid.Column="1"
                                    Text="{Binding Gesture, UpdateSourceTrigger=PropertyChanged}"
                                    IsReadOnly="True"
                                    IsHitTestVisible="True"
                                    Focusable="True"          
                                    IsTabStop="True" 
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource PrimaryHueMidBrush}"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Padding="8,6"
                                    Background="White"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    CaretIndex="0"
                                    Tag="{Binding}">
                                    <!-- ВАЖНО: передает ту же ссылку на объект, что и кнопка -->
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="Cursor" Value="IBeam"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                    <Setter Property="Background" Value="#FFF9E6"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <!-- Кнопка записи -->
                                <Button Grid.Column="2" Content="Записать"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Click="RecordButton_Click"
                                        Tag="{Binding}"
                                        HorizontalAlignment="Stretch"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Статус -->
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="Gray"
                       Margin="0,12,0,0" MinHeight="18"/>

            <!-- Кнопки действий -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="По умолчанию"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Click="Reset_Click" Margin="0,0,10,0"/>
                <Button Content="Сохранить"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="Save_Click" Margin="0,0,10,0"/>
                <Button Content="Закрыть"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"/>
            </StackPanel>
        </StackPanel>
    </materialDesign:Card>
</UserControl>