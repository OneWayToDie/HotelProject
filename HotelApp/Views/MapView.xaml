<!-- Представление карты отеля -->
<UserControl x:Class="HotelApp.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <!-- Основная сетка представления -->
    <Grid Margin="20">
        <!-- Строки разметки представления -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок раздела карты -->
        <TextBlock Grid.Row="0" Text="Карта отеля" FontSize="24" FontWeight="Bold" 
                   Margin="0,0,0,20" Foreground="{DynamicResource PrimaryHueMidBrush}"/>

        <!-- Прокручиваемая область карты корпусов -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <!-- Список корпусов отеля -->
            <ItemsControl ItemsSource="{Binding Buildings}">
                <!-- Шаблон отображения корпуса -->
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Блок корпуса и его номеров -->
                        <StackPanel Margin="0,0,0,10">
                            <!-- Заголовок корпуса -->
                            <StackPanel Orientation="Horizontal" Margin="8,10,0,5">
                                <materialDesign:PackIcon Kind="OfficeBuilding" Width="22" Height="22"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                <TextBlock Text="{Binding BuildingName}" FontSize="18" FontWeight="Bold"
                                           Margin="8,0,6,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                <TextBlock Text="{Binding Rooms.Count, StringFormat='({0} номеров)'}"
                                           FontSize="14" VerticalAlignment="Center" Foreground="Gray"/>
                            </StackPanel>

                            <!-- Список плиток номеров корпуса -->
                            <ItemsControl ItemsSource="{Binding Rooms}">
                                <!-- Панель размещения плиток номеров -->
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <!-- Шаблон плитки номера -->
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Карточка номера на карте -->
                                        <Border Width="160" Height="130" Margin="8" CornerRadius="10"
                                                Background="{Binding StatusColor}" Cursor="Hand"
                                                BorderBrush="#33FFFFFF" BorderThickness="1"
                                                ToolTip="{Binding DateDisplay}"
                                                MouseLeftButtonDown="Room_Click">

                                            <!-- Содержимое карточки номера -->
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="6">
                                                <!-- Номер комнаты и индикатор люкса -->
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="Star" Width="18" Height="18"
                                                                             Foreground="#FFD54F" Margin="0,0,4,0"
                                                                             VerticalAlignment="Center">
                                                        <materialDesign:PackIcon.Style>
                                                            <!-- Стиль отображения индикатора люкса -->
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <!-- Показ индикатора для люкса -->
                                                                    <DataTrigger Binding="{Binding IsLux}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                    <TextBlock Text="{Binding Number}" FontSize="26" FontWeight="Bold"
                                                               Foreground="White"/>
                                                </StackPanel>

                                                <!-- Тип номера -->
                                                <TextBlock Text="{Binding TypeText}" FontSize="12"
                                                           Foreground="White" Opacity="0.9"
                                                           HorizontalAlignment="Center"/>

                                                <!-- Цена номера -->
                                                <TextBlock Text="{Binding PriceLabel}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="White" Opacity="0.95" Margin="0,2,0,0"
                                                           HorizontalAlignment="Center"/>

                                                <!-- Имя гостя для занятого номера -->
                                                <TextBlock Text="{Binding DisplayGuest}" FontSize="10"
                                                           Foreground="White" Opacity="0.85"
                                                           HorizontalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="140">
                                                    <TextBlock.Style>
                                                        <!-- Стиль отображения имени гостя -->
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <!-- Показ имени для занятого номера -->
                                                                <DataTrigger Binding="{Binding Status}" Value="1">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
