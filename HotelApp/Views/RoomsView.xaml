<!-- Представление управления номерами и номерным фондом -->
<UserControl x:Class="HotelApp.Views.RoomsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <!-- Основная сетка представления -->
    <Grid Margin="20">
        <!-- Строки разметки представления -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель фильтров и поиска -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <!-- Переключатели фильтрации номеров -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Фильтр:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                <!-- Переключатели статусов номеров -->
                <RadioButton Content="Все" GroupName="RoomFilter" IsChecked="True" Tag="0" Checked="Filter_Checked" Margin="0,0,10,0"/>
                <RadioButton Content="Свободные" GroupName="RoomFilter" Tag="1" Checked="Filter_Checked" Margin="0,0,10,0"/>
                <RadioButton Content="Занятые" GroupName="RoomFilter" Tag="2" Checked="Filter_Checked"/>
            </StackPanel>

            <!-- Поле живого поиска -->
            <DockPanel Width="300" HorizontalAlignment="Right" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="Magnify" Width="22" Height="22" VerticalAlignment="Bottom"
                                         Margin="0,0,8,8" Foreground="Gray"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Поиск по номеру или гостю"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
            </DockPanel>
        </Grid>

        <!-- Панель действий с номерами -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <!-- Кнопка заселения гостя -->
            <Button Content="Заселить гостя" Style="{StaticResource MaterialDesignRaisedButton}" 
                    Click="CheckIn_Click" Margin="0,0,10,0" Width="150"/>
            <!-- Кнопка бронирования номера -->
            <Button Content="Забронировать" Style="{StaticResource MaterialDesignOutlinedButton}" 
                    Click="Book_Click" Margin="0,0,10,0" Width="150"/>
            <!-- Кнопка выселения гостя -->
            <Button Content="Выселить" Style="{StaticResource MaterialDesignOutlinedButton}" 
                    Click="CheckOut_Click" Margin="0,0,10,0" Width="110"/>
            <!-- Кнопка завершения уборки -->
            <Button Content="Завершить уборку" Style="{StaticResource MaterialDesignOutlinedButton}" 
                    Click="FinishCleaning_Click" Margin="0,0,10,0" Width="190"/>
            <!-- Кнопка изменения цены -->
            <Button Content="Изменить цену" Style="{StaticResource MaterialDesignOutlinedButton}" 
                    Click="EditPrice_Click" Width="150"/>
        </StackPanel>

        <!-- Таблица номеров -->
        <Border Grid.Row="2" Padding="0" CornerRadius="4"
                Background="{DynamicResource MaterialDesignPaper}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="1">
            <!-- Таблица списка номеров -->
            <DataGrid x:Name="RoomsGrid" ItemsSource="{Binding Rooms}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column"
                      MouseDoubleClick="RoomsGrid_MouseDoubleClick">
                <!-- Набор столбцов таблицы номеров -->
                <DataGrid.Columns>
                    <!-- Столбец номера комнаты -->
                    <DataGridTextColumn Header="Номер" Binding="{Binding Number}" Width="80" MinWidth="70"/>
                    <!-- Столбец типа номера -->
                    <DataGridTextColumn Header="Тип" Binding="{Binding TypeText}" Width="165" MinWidth="150"/>
                    <!-- Столбец цены номера -->
                    <DataGridTextColumn Header="Цена" Binding="{Binding BasePrice, StringFormat={}{0:N0} ₽}" Width="100" MinWidth="90"/>
                    <!-- Столбец текущего гостя -->
                    <DataGridTextColumn Header="Гость" Binding="{Binding DisplayGuest}" Width="190" MinWidth="160"/>
                    <!-- Столбец дат проживания -->
                    <DataGridTextColumn Header="Даты" Binding="{Binding DateDisplay}" Width="180" MinWidth="180"/>
                    <!-- Столбец информации о бронировании -->
                    <DataGridTemplateColumn Header="Бронь" Width="*" MinWidth="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <!-- Шаблон ячейки бронирования -->
                            <DataTemplate>
                                <!-- Текст информации о бронировании -->
                                <TextBlock Text="{Binding BookingInfo}" VerticalAlignment="Center" Margin="4,0">
                                    <TextBlock.Style>
                                        <!-- Стиль текста бронирования -->
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            <Style.Triggers>
                                                <!-- Подсветка текста при ожидании заезда -->
                                                <DataTrigger Binding="{Binding IsWaitingForCheckIn}" Value="True">
                                                    <Setter Property="Foreground" Value="MediumSeaGreen"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- Столбец статуса номера -->
                    <DataGridTemplateColumn Header="Статус" Width="120" MinWidth="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <!-- Шаблон ячейки статуса -->
                            <DataTemplate>
                                <!-- Индикатор статуса номера -->
                                <Border Background="{Binding StatusColor}" CornerRadius="4" Padding="6,2" Margin="4">
                                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontWeight="Bold" TextAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>