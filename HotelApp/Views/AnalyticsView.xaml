<UserControl x:Class="HotelApp.Views.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Графики и выручка (в разработке)" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <materialDesign:Card Grid.Row="1" Padding="20">
            <ProgressBar Value="75" Height="30" Style="{StaticResource MaterialDesignLinearProgressBar}"/>
        </materialDesign:Card>
    </Grid>
</UserControl>