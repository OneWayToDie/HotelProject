<UserControl x:Class="HotelApp.Views.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Аналитика отеля" FontSize="24" FontWeight="Bold" 
                       Margin="0,0,0,20" Foreground="{DynamicResource PrimaryHueMidBrush}"/>

            <!-- КАРТОЧКИ -->
            <UniformGrid Grid.Row="1" Columns="5">
                <!-- Карточка 1: Всего номеров -->
                <materialDesign:Card Margin="8" Padding="20" UniformCornerRadius="12">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="HomeGroup" Width="32" Height="32"
                                                  Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <TextBlock Text="Всего номеров" Margin="0,10,0,0" Foreground="Gray" FontSize="12"/>
                        <TextBlock Text="{Binding TotalRooms}" FontSize="28" FontWeight="Bold" 
                                   Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Карточка 2: Загрузка -->
                <materialDesign:Card Margin="8" Padding="20" UniformCornerRadius="12">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="ChartPie" Width="32" Height="32" 
                                                  Foreground="{Binding OccupancyColor}"/>
                        <TextBlock Text="Загрузка отеля" Margin="0,10,0,0" Foreground="Gray" FontSize="12"/>
                        <TextBlock Text="{Binding OccupancyLabel}" FontSize="28" FontWeight="Bold" 
                                   Foreground="{Binding OccupancyColor}"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Карточка 3: Свободно -->
                <materialDesign:Card Margin="8" Padding="20" UniformCornerRadius="12">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="DoorOpen" Width="32" Height="32" Foreground="MediumSeaGreen"/>
                        <TextBlock Text="Свободно сейчас" Margin="0,10,0,0" Foreground="Gray" FontSize="12"/>
                        <TextBlock Text="{Binding FreeRooms}" FontSize="28" FontWeight="Bold" Foreground="MediumSeaGreen"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Карточка 4: Ожидаемая выручка -->
                <materialDesign:Card Margin="8" Padding="20" UniformCornerRadius="12"
                                    ToolTip="Стоимость текущих заселений и действующих броней (цена за сутки × число суток)">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="CashMultiple" Width="32" Height="32" Foreground="#FFB300"/>
                        <TextBlock Text="Ожид. выручка" Margin="0,10,0,0" Foreground="Gray" FontSize="12"/>
                        <TextBlock Text="{Binding RevenueLabel}" FontSize="22" FontWeight="Bold" Foreground="#FFB300"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Карточка 5: Общая выручка -->
                <materialDesign:Card Margin="8" Padding="20" UniformCornerRadius="12"
                                    ToolTip="Накопленная выручка по выселениям плюс ожидаемая по заселениям и броням">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="Cash" Width="32" Height="32" Foreground="#2E7D32"/>
                        <TextBlock Text="Общая выручка" Margin="0,10,0,0" Foreground="Gray" FontSize="12"/>
                        <TextBlock Text="{Binding TotalRevenueLabel}" FontSize="22" FontWeight="Bold" Foreground="#2E7D32"/>
                    </StackPanel>
                </materialDesign:Card>
            </UniformGrid>

            <!-- ГРАФИК ЗАГРУЗКИ -->
            <materialDesign:Card Grid.Row="2" Margin="8,20,8,0" Padding="24" UniformCornerRadius="12">
                <StackPanel>
                    <TextBlock Text="Загрузка отеля" FontSize="18" FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,15"/>
                    <ProgressBar Value="{Binding OccupancyPercent, Mode=OneWay}" 
                                 Height="30" 
                                 Foreground="{Binding OccupancyColor}" 
                                 Background="#E0E0E0"
                                 Style="{StaticResource MaterialDesignLinearProgressBar}"/>

                    <TextBlock Text="{Binding OccupancyLabel, StringFormat='Заполнено {0} номеров'}" 
                               Margin="0,10,0,0" Foreground="Gray"/>

                    <Separator Margin="0,20"/>

                    <!-- Мини-статистика -->
                    <UniformGrid Columns="3">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding FreeRooms}" FontSize="20" FontWeight="Bold" 
                                       Foreground="MediumSeaGreen" HorizontalAlignment="Center"/>
                            <TextBlock Text="Свободно" Foreground="Gray" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding OccupiedRooms}" FontSize="20" FontWeight="Bold" 
                                       Foreground="IndianRed" HorizontalAlignment="Center"/>
                            <TextBlock Text="Занято" Foreground="Gray" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding CleaningRooms}" FontSize="20" FontWeight="Bold" 
                                       Foreground="Orange" HorizontalAlignment="Center"/>
                            <TextBlock Text="На уборке" Foreground="Gray" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </ScrollViewer>
</UserControl>